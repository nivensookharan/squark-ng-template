{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "b2-test: serve",
      "type": "shell",
      "command": "ng serve",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/b2-test"
      },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
